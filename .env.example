# FleetSense Environment Configuration
# Copy to .env and edit as needed. Never commit .env to Git.

# Data year to process (default: 2024)
FLEETSENSE_DATA_YEAR=2024

# Override base data directory (default: ./data)
# FLEETSENSE_DATA_DIR=./data

# Log level (DEBUG, INFO, WARNING, ERROR)
FLEETSENSE_LOG_LEVEL=INFO
